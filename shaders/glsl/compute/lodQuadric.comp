#version 430 core

#include "floatAtomic.glsl"

layout(local_size_x = 64) in;

struct Vertex {
  float position[3];
  float normal[3];
  float texCoord[2];
  float tangent[3];
};

struct LodQuadric {
  ATOMIC_FLOAT_T q[10];
  ATOMIC_FLOAT_T posSum[3];
  ATOMIC_FLOAT_T norSum[3];
  ATOMIC_FLOAT_T texSum[2];
  uint count;
};

struct QuadricF {
  float q[10];
};

layout(std430, binding = 8) readonly buffer SourceVertices {
  Vertex vertices[];
};

layout(std430, binding = 9) readonly buffer SourceIndices { uint indices[]; };

layout(std430, binding = 10) buffer ClusterQuadrics { LodQuadric clusters[]; };

// # of divisions
uniform ivec3 uGrid;
uniform vec3 uAabbMin;
// size of each cell
uniform vec3 uCellSize;
uniform int uTriangleCount;

// find part of cluster grid vert is in
uint findCluster(vec3 position) {
  ivec3 npos = ivec3(floor((position) / uCellSize));
  npos = clamp(npos, ivec3(0), uGrid - ivec3(1));
  return uint(uGrid.x * uGrid.y * npos.z + npos.y * uGrid.x + npos.x);
}

QuadricF toQuadricF(mat4 m) {
  QuadricF quad;

  quad.q[0] = m[0][0];
  quad.q[1] = m[0][1];
  quad.q[2] = m[0][2];
  quad.q[3] = m[0][3];

  quad.q[4] = m[1][1];
  quad.q[5] = m[1][2];
  quad.q[6] = m[1][3];

  quad.q[7] = m[2][2];
  quad.q[8] = m[2][3];

  quad.q[9] = m[3][3];

  return quad;
}

void main() {

  // check if valid triangles
  if (gl_GlobalInvocationID.x >= uint(uTriangleCount))
    return;

  uint triangleIndex = gl_GlobalInvocationID.x * 3;

  vec3 pos[3];
  for (uint i = 0; i < 3; i++) {
    Vertex vtx = vertices[indices[triangleIndex + i]];
    pos[i] = vec3(vtx.position[0], vtx.position[1], vtx.position[2]) - uAabbMin;
  }
  vec3 e0 = pos[1] - pos[0];
  vec3 e1 = pos[2] - pos[0];

  // reject degenerate triangles BEFORE normalizing
  vec3 cr = cross(e0, e1);
  float len = length(cr);
  if (len < 1e-12)
    return;
  vec3 n = cr / len;

  // plane equation: ax + by + cz + d = 0
  float d = -dot(n, pos[0]);
  vec4 p = vec4(n, d);

  // face quadric
  mat4 Q = outerProduct(p, p);
  Q *= 0.5 * len;

  QuadricF lq = toQuadricF(Q);

  // add this face's quadric (and each corner's position) to the corner's
  // cluster
  for (uint i = 0; i < 3; i++) {
    uint vertexIndex = indices[triangleIndex + i];
    Vertex vtx = vertices[vertexIndex];

    uint c = findCluster(pos[i]);

    for (uint j = 0; j < 10; j++) {
      ATOMIC_ADD_FLOAT(clusters[c].q[j], lq.q[j]);
    }

    for (uint k = 0; k < 3; k++) {
      ATOMIC_ADD_FLOAT(clusters[c].posSum[k], pos[i][k]);
      ATOMIC_ADD_FLOAT(clusters[c].norSum[k], vtx.normal[k]);
    }

    for (uint k = 0; k < 2; k++) {
      ATOMIC_ADD_FLOAT(clusters[c].texSum[k], vtx.texCoord[k]);
    }

    atomicAdd(clusters[c].count, 1u);
  }
}
