#version 430 core

#include "floatAtomic.glsl"

layout(local_size_x = 64) in;

struct Vertex {
  float position[3];
  float normal[3];
  float texCoord[2];
  float tangent[3];
};

struct LodQuadric {
  ATOMIC_FLOAT_T q[10];
  ATOMIC_FLOAT_T posSum[3];
  ATOMIC_FLOAT_T norSum[3];
  ATOMIC_FLOAT_T texSum[2];
  uint count;
};

struct QuadricF {
  float q[10];
};

layout(std430, binding = 10) readonly buffer ClusterQuadrics {
  LodQuadric clusters[];
};
layout(std430, binding = 11) buffer OptminalVerts { vec4 verts[]; };

QuadricF loadQuadricF(uint index) {
  QuadricF quad;
  for (int i = 0; i < 10; i++) {
    quad.q[i] = ATOMIC_GET_FLOAT(clusters[index].q[i]);
  }
  return quad;
}

mat4 toMat4(QuadricF quad) {
  mat4 m = mat4(0.0);

  m[0][0] = quad.q[0];
  m[0][1] = quad.q[1];
  m[0][2] = quad.q[2];
  m[0][3] = quad.q[3];
  m[1][0] = quad.q[1];
  m[1][1] = quad.q[4];
  m[1][2] = quad.q[5];
  m[1][3] = quad.q[6];
  m[2][0] = quad.q[2];
  m[2][1] = quad.q[5];
  m[2][2] = quad.q[7];
  m[2][3] = quad.q[8];
  m[3][0] = quad.q[3];
  m[3][1] = quad.q[6];
  m[3][2] = quad.q[8];
  m[3][3] = quad.q[9];

  return m;
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  QuadricF qf = loadQuadricF(idx);
  mat4 Q = toMat4(qf);

  uint cnt = clusters[idx].count;
  vec3 avg = vec3(0.0);
  vec3 avgNormal = vec3(0.0);
  vec2 avgTexCoord = vec2(0.0);

  if (cnt > 0u) {
    avg = vec3(ATOMIC_GET_FLOAT(clusters[idx].posSum[0]),
               ATOMIC_GET_FLOAT(clusters[idx].posSum[1]),
               ATOMIC_GET_FLOAT(clusters[idx].posSum[2])) /
          float(cnt);

    avgNormal = vec3(ATOMIC_GET_FLOAT(clusters[idx].norSum[0]),
                     ATOMIC_GET_FLOAT(clusters[idx].norSum[1]),
                     ATOMIC_GET_FLOAT(clusters[idx].norSum[2]));

    if (length(avgNormal) > 1e-12) {
      avgNormal = normalize(avgNormal);
    } else {
      avgNormal = vec3(0.0, 1.0, 0.0);
    }

    avgTexCoord = vec2(ATOMIC_GET_FLOAT(clusters[idx].texSum[0]),
                       ATOMIC_GET_FLOAT(clusters[idx].texSum[1])) /
                  float(cnt);
  }

  mat3 A = mat3(Q);
  vec3 b = vec3(Q[0][3], Q[1][3], Q[2][3]);

  float det = determinant(A);
  vec3 optVert = vec3(0.0);

  if (cnt == 0u || abs(det) < 1e-10) {
    optVert = avg;
  } else {
    optVert = inverse(A) * (-b);
  }

  verts[idx] = vec4(optVert, 0.0);
}