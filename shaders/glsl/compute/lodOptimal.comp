#version 430 core

#include "floatAtomic.glsl"

layout(local_size_x = 64) in;

struct Vertex {
  float position[3];
  float normal[3];
  float texCoord[2];
  float tangent[3];
};

struct LodQuadric {
  ATOMIC_FLOAT_T q[10];
  ATOMIC_FLOAT_T posSum[3];
  uint count;
};

struct QuadricF {
  float q[10];
};

layout(std430, binding = 10) readonly buffer ClusterQuadrics {
  LodQuadric clusters[];
};
layout(std430, binding = 11) buffer OptminalVerts { vec4 verts[]; };

mat4 toMat4(QuadricF quad) {
  mat4 m = mat4(0.0);

  m[0][0] = quad.q[0];
  m[0][1] = quad.q[1];
  m[0][2] = quad.q[2];
  m[0][3] = quad.q[3];

  m[1][0] = quad.q[1];
  m[1][1] = quad.q[4];
  m[1][2] = quad.q[5];
  m[1][3] = quad.q[6];

  m[2][0] = quad.q[2];
  m[2][1] = quad.q[5];
  m[2][2] = quad.q[7];
  m[2][3] = quad.q[8];

  m[3][0] = quad.q[3];
  m[3][1] = quad.q[6];
  m[3][2] = quad.q[8];
  m[3][3] = quad.q[9];

  return m;
}

void main() {
  mat4 Q = toMat4(clusters[gl_GlobalInvocationID.x].q);
  vec3 avg(0);
  for (uint i = 0; i < 3; i++) {
    avg[i] = (clusters[gl_GlobalInvocationID.x].posSum[i]) / count;
  }

  mat3 A = mat3(Q);

  vec3 b = vec3(Q[0][3], Q[1][3], Q[2][3]);

  // research further
  float det = determinant(A);

  vec3 optVert(0);

  if (abs(det) < 1e-10) {
    optVert = avg;
  } else {
    optVert = -inverse(A) * b;
  }

  OptminalVerts[gl_GlobalInvocationID.x] = vec4(optVert, 0.0)
}
