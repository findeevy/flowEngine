#version 430 core
// Pass 1a (per triangle): face quadric * (area/3) added to each corner's
// per-vertex quadric (paper Eq. 8: Qv = sum over adjacent faces Qf * Af/3).

#include "../floatAtomic.glsl"
#include "../quadric.glsl"
#include "../vertex.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 8) readonly buffer SourceVertices {
  Vertex vertices[];
};
layout(std430, binding = 9) readonly buffer SourceIndices { uint indices[]; };
layout(std430, binding = 23) buffer VertQuadrics {
  ATOMIC_FLOAT_T vq[];
};

uniform vec3 uAabbMin;
uniform int uTriangleCount;

void main() {
  if (gl_GlobalInvocationID.x >= uint(uTriangleCount))
    return;
  uint t = gl_GlobalInvocationID.x * 3u;

  uint vi[3];
  vec3 pos[3];
  for (uint i = 0u; i < 3u; i++) {
    vi[i] = indices[t + i];
    Vertex v = vertices[vi[i]];
    pos[i] = vec3(v.position[0], v.position[1], v.position[2]) - uAabbMin;
  }

  vec3 cr = cross(pos[1] - pos[0], pos[2] - pos[0]);
  float len = length(cr);
  if (len < 1e-12)
    return;
  vec3 n = cr / len;

  vec4 p = vec4(n, -dot(n, pos[0]));
  mat4 Q = outerProduct(p, p);
  Q *= (0.5 * len) / 3.0; // area / 3
  QuadricF lq = toQuadricF(Q);

  for (uint i = 0u; i < 3u; i++) {
    for (uint k = 0u; k < 10u; k++) {
      float val = lq.q[k];
      ATOMIC_ADD_FLOAT(vq[vi[i] * 10u + k], val);
    }
  }
}
