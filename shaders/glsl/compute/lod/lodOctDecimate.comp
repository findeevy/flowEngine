#version 430 core

#include "../vertex.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 8) readonly buffer SourceVertices {
  Vertex vertices[];
};
layout(std430, binding = 9) readonly buffer SourceIndices { uint indices[]; };
layout(std430, binding = 11) readonly buffer OptminalVerts { vec4 optVerts[]; };
layout(std430, binding = 12) buffer OutVerts { Vertex oVerts[]; };
layout(std430, binding = 13) buffer OutInd { uint oInds[]; };
layout(std430, binding = 14) buffer Counter { uint outCount; };
layout(std430, binding = 15) buffer Best { uint best[]; };
layout(std430, binding = 16) buffer HashTable { uint table[]; };
layout(std430, binding = 19) readonly buffer VertCluster {
  uint vertCluster[];
};
layout(std430, binding = 24) buffer Remap { uint remap[]; };
layout(std430, binding = 25) buffer VertCounter { uint vertOut; };

const uint EMPTY = 0xFFFFFFFFu;
const uint NONE = 0xFFFFFFFFu;
const uint USED = 0xFFFFFFFEu;

uniform vec3 uAabbMin;
uniform uint uVertexCount;
uniform uint uTriangleCount;
uniform uint uClusterCount;
uniform uint uIndexCount; // for pass 4
uniform uint uTableMask;

// 0 = closest distance and 1 = closest index (tie break)   [per vertex]
// 2 = emit unique non-degenerate triangles, mark used clusters [per triangle]
// 3 = compact: dense output vertex per used cluster      [per slot]
// 4 = rewrite output indices to the dense numbering      [per output index]
uniform uint uPass;

uvec3 sort3(uvec3 v) {
  if (v.x > v.y)
    v.xy = v.yx;
  if (v.y > v.z)
    v.yz = v.zy;
  if (v.x > v.y)
    v.xy = v.yx;
  return v;
}

uint hash3(uvec3 k) {
  uint h = k.x * 0x9E3779B1u;
  h = (h ^ (h >> 15)) + k.y * 0x85EBCA77u;
  h = (h ^ (h >> 13)) + k.z * 0xC2B2AE3Du;
  h ^= h >> 16;
  return h;
}

vec3 getPos(uint vi) {
  Vertex v = vertices[vi];
  return vec3(v.position[0], v.position[1], v.position[2]) - uAabbMin;
}

uvec3 clustersOfTri(uint t) {
  return uvec3(vertCluster[indices[3u * t + 0u]],
               vertCluster[indices[3u * t + 1u]],
               vertCluster[indices[3u * t + 2u]]);
}

void main() {
  uint gid = gl_GlobalInvocationID.x;

  if (uPass < 2u) {
    if (gid >= uVertexCount)
      return;
    uint c = vertCluster[gid];
    if (c == NONE)
      return;
    vec3 d = getPos(gid) - optVerts[c].xyz;
    uint db = floatBitsToUint(dot(d, d));
    if (uPass == 0u) {
      atomicMin(best[2u * c], db);
    } else if (db == best[2u * c]) {
      atomicMin(best[2u * c + 1u], gid);
    }
    return;
  }

  if (uPass == 3u) {
    if (gid >= uClusterCount)
      return;
    if (remap[gid] != USED)
      return;
    uint idx = atomicAdd(vertOut, 1u);
    remap[gid] = idx;
    Vertex s = vertices[best[2u * gid + 1u]];
    vec3 p = optVerts[gid].xyz + uAabbMin;
    oVerts[idx].position[0] = p.x;
    oVerts[idx].position[1] = p.y;
    oVerts[idx].position[2] = p.z;
    for (int k = 0; k < 3; k++)
      oVerts[idx].normal[k] = s.normal[k];
    for (int k = 0; k < 2; k++)
      oVerts[idx].texCoord[k] = s.texCoord[k];
    for (int k = 0; k < 3; k++)
      oVerts[idx].tangent[k] = s.tangent[k];
    return;
  }

  if (uPass == 4u) {
    if (gid >= uIndexCount)
      return;
    oInds[gid] = remap[oInds[gid]];
    return;
  }

  // pass 2
  if (gid >= uTriangleCount)
    return;

  uvec3 cl = clustersOfTri(gid);
  if (cl.x == NONE || cl.y == NONE || cl.z == NONE)
    return; // a vertex lost even its root node (hash table overflow)
  if (cl.x == cl.y || cl.x == cl.z || cl.y == cl.z)
    return;

  uvec3 key = sort3(cl);
  uint slot = hash3(key) & uTableMask;
  bool isUnique = false;

  for (uint probe = 0u; probe <= uTableMask; probe++) {
    uint prev = atomicCompSwap(table[slot], EMPTY, gid);
    if (prev == EMPTY) {
      isUnique = true;
      break;
    }
    if (sort3(clustersOfTri(prev)) == key)
      break;
    slot = (slot + 1u) & uTableMask;
  }
  if (!isUnique)
    return;

  uint o = atomicAdd(outCount, 3u);
  oInds[o + 0u] = cl.x;
  oInds[o + 1u] = cl.y;
  oInds[o + 2u] = cl.z;
  remap[cl.x] = USED;
  remap[cl.y] = USED;
  remap[cl.z] = USED;
}
