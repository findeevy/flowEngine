#version 430 core

#include "../vertex.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 8) readonly buffer SourceVertices {
  Vertex vertices[];
};

layout(std430, binding = 9) readonly buffer SourceIndices { uint indices[]; };

layout(std430, binding = 11) readonly buffer OptminalVerts { vec4 optVerts[]; };

layout(std430, binding = 12) buffer OutVerts { Vertex oVerts[]; };
layout(std430, binding = 13) buffer OutInd { uint oInds[]; };

layout(std430, binding = 14) buffer Counter { uint outCount; };
layout(std430, binding = 15) buffer Best { uint best[]; };

layout(std430, binding = 16) buffer HashTable { uint table[]; };
const uint EMPTY = 0xFFFFFFFFu;

uvec3 sort3(uvec3 v) {
  if (v.x > v.y)
    v.xy = v.yx;
  if (v.y > v.z)
    v.yz = v.zy;
  if (v.x > v.y)
    v.xy = v.yx;
  return v;
}

uint hash3(uvec3 k) {
  uint h = k.x * 0x9E3779B1u;
  h = (h ^ (h >> 15)) + k.y * 0x85EBCA77u;
  h = (h ^ (h >> 13)) + k.z * 0xC2B2AE3Du;
  h ^= h >> 16;
  return h;
}

// # of divisions
uniform ivec3 uGrid;
uniform vec3 uAabbMin;
// size of each cell
uniform vec3 uCellSize;
uniform int uTriangleCount;

// for hash
uniform uint uTableMask;

// 0 = closest distance, 1 = closest index tie-break, 2 = emit
uniform uint uPass;

vec3 getPos(uint vi) {
  Vertex v = vertices[vi];
  return vec3(v.position[0], v.position[1], v.position[2]) - uAabbMin;
}

// find part of cluster grid vert is in
uint findCluster(vec3 position) {
  ivec3 npos = ivec3(floor((position) / uCellSize));
  npos = clamp(npos, ivec3(0), uGrid - ivec3(1));
  return uint(uGrid.x * uGrid.y * npos.z + npos.y * uGrid.x + npos.x);
}

uvec3 clustersOfTri(uint t) {
  return uvec3(findCluster(getPos(indices[3u * t + 0u])),
               findCluster(getPos(indices[3u * t + 1u])),
               findCluster(getPos(indices[3u * t + 2u])));
}

uint distBits(vec3 p, uint cluster) {
  vec3 d = p - optVerts[cluster].xyz;
  return floatBitsToUint(dot(d, d));
}

void writeClusterVertex(uint cluster) {
  Vertex s = vertices[best[2u * cluster + 1u]];
  vec3 p = optVerts[cluster].xyz + uAabbMin;

  oVerts[cluster].position[0] = p.x;
  oVerts[cluster].position[1] = p.y;
  oVerts[cluster].position[2] = p.z;

  for (int k = 0; k < 3; k++)
    oVerts[cluster].normal[k] = s.normal[k];
  for (int k = 0; k < 2; k++)
    oVerts[cluster].texCoord[k] = s.texCoord[k];
  for (int k = 0; k < 3; k++)
    oVerts[cluster].tangent[k] = s.tangent[k];
}

void main() {
  if (gl_GlobalInvocationID.x >= uint(uTriangleCount))
    return;

  uint triangleIndex = gl_GlobalInvocationID.x * 3u;

  if (uPass < 2u) {
    for (uint i = 0u; i < 3u; i++) {
      uint vi = indices[triangleIndex + i];
      vec3 p = getPos(vi);
      // distance from optimal position in cell
      uint c = findCluster(p);
      uint db = distBits(p, c);
      // set minimum, then break the tie if there is one
      if (uPass == 0u) {
        atomicMin(best[2u * c], db);
      } else if (db == best[2u * c]) {
        atomicMin(best[2u * c + 1u], vi);
      }
    }
    return;
  }

  // load triangle
  uint ix = indices[triangleIndex + 0u];
  uint iy = indices[triangleIndex + 1u];
  uint iz = indices[triangleIndex + 2u];

  vec3 vx = getPos(ix);
  vec3 vy = getPos(iy);
  vec3 vz = getPos(iz);

  // check if occupy same cluster (mark bad if it does)
  uint cx = findCluster(vx);
  uint cy = findCluster(vy);
  uint cz = findCluster(vz);

  // check if degenerate
  if (cx == cy || cx == cz || cz == cy) {
    return;
  }

  uvec3 key = sort3(uvec3(cx, cy, cz));
  uint slot = hash3(key) & uTableMask;
  bool isUnique = false;

  for (uint probe = 0u; probe <= uTableMask; probe++) {
    uint prev = atomicCompSwap(table[slot], EMPTY, gl_GlobalInvocationID.x);
    if (prev == EMPTY) {
      isUnique = true;
      break;
    }
    if (sort3(clustersOfTri(prev)) == key)
      break;
    slot = (slot + 1u) & uTableMask;
  }

  if (!isUnique)
    return;

  uint o = atomicAdd(outCount, 3u);
  oInds[o + 0u] = cx;
  oInds[o + 1u] = cy;
  oInds[o + 2u] = cz;

  writeClusterVertex(cx);
  writeClusterVertex(cy);
  writeClusterVertex(cz);
}